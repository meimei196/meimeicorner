{
  "entities": {
    "BotStats": {
      "title": "Bot Stats",
      "description": "Real-time statistics for a bot",
      "type": "object",
      "properties": {
        "chatCount": { "type": "number", "description": "Total messages sent to this bot" },
        "likesCount": { "type": "number", "description": "Total likes for this bot" }
      },
      "required": ["chatCount", "likesCount"]
    },
    "UserData": {
      "title": "User Data",
      "description": "User specific data including personas, chats, and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "personas": { "type": "array" },
        "activePersonaId": { "type": "string" },
        "chats": { "type": "object" },
        "activeSessionIds": { "type": "object" },
        "likedBots": { "type": "array" },
        "apiKey": { "type": "string" },
        "model": { "type": "string" },
        "temperature": { "type": "number" },
        "customApiUrl": { "type": "string" },
        "provider": { "type": "string" },
        "affectionLevels": { "type": "object" },
        "isOnboarded": { "type": "boolean" },
        "updatedAt": { "type": "number", "description": "Timestamp of last update" }
      },
      "required": ["userId"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Anonymous feedback from users",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "The feedback text" },
        "createdAt": { "type": "number", "description": "Timestamp when feedback was submitted" },
        "status": { "type": "string", "description": "Status of the feedback (unread, read)" }
      },
      "required": ["content", "createdAt"]
    },
    "BotComment": {
      "title": "Bot Comment",
      "description": "Anonymous comments for a bot",
      "type": "object",
      "properties": {
        "botId": { "type": "string", "description": "ID of the target bot" },
        "nickname": { "type": "string", "description": "Nickname of the commenter" },
        "content": { "type": "string", "description": "Comment content text" },
        "images": { "type": "array", "description": "Array of compressed image data strings" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["botId", "content", "createdAt"]
    }
  },
  "firestore": {
    "/bot_stats/{botId}": {
      "schema": "BotStats",
      "description": "Real-time stats for a specific bot"
    },
    "/users/{userId}": {
      "schema": "UserData",
      "description": "Data for a specific user"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "Anonymous feedbacks collection"
    },
    "/bot_comments/{commentId}": {
      "schema": "BotComment",
      "description": "Anonymous comments collection for bots"
    }
  }
}
